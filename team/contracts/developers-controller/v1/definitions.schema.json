{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/developers-controller/v1/definitions.schema.json",
  "title": "Shimpz Developers to Controller contract definitions v1",
  "$defs": {
    "accountIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$"
    },
    "teamIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,40}$"
    },
    "assistantIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {
        "enum": [
          "postgres",
          "app-egress-proxy"
        ]
      }
    },
    "componentIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "imageReference": {
      "type": "string",
      "pattern": "^ghcr\\.io/theshimpz/shimpz-assistants@sha256:[0-9a-f]{64}$"
    },
    "trustReference": {
      "type": "string",
      "pattern": "^ghcr\\.io/theshimpz/shimpz-assistant-trust@sha256:[0-9a-f]{64}$"
    },
    "opaqueIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "unixTime": {
      "type": "integer",
      "minimum": 0
    },
    "teamListDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "account_id",
        "action",
        "jti",
        "iat",
        "exp",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "iss": {
          "const": "https://developers.shimpz.com"
        },
        "aud": {
          "const": "https://developers.shimpz.com/team-controller"
        },
        "account_id": {
          "$ref": "#/$defs/accountIdentifier"
        },
        "action": {
          "const": "teams:list"
        },
        "jti": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "iat": {
          "$ref": "#/$defs/unixTime"
        },
        "exp": {
          "$ref": "#/$defs/unixTime"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "assistantInstallDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "account_id",
        "action",
        "team_id",
        "source_digest",
        "jti",
        "iat",
        "exp",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "iss": {
          "const": "https://developers.shimpz.com"
        },
        "aud": {
          "const": "https://developers.shimpz.com/team-controller"
        },
        "account_id": {
          "$ref": "#/$defs/accountIdentifier"
        },
        "action": {
          "const": "assistant:install"
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "jti": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "iat": {
          "$ref": "#/$defs/unixTime"
        },
        "exp": {
          "$ref": "#/$defs/unixTime"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "delegationClaims": {
      "oneOf": [
        {
          "$ref": "#/$defs/teamListDelegation"
        },
        {
          "$ref": "#/$defs/assistantInstallDelegation"
        }
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "teamListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "teams"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          }
        }
      }
    },
    "objectSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_schema",
        "output_schema",
        "accounts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "input_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "accounts": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentIdentifier"
          }
        }
      }
    },
    "machineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "powers"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "powers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/power"
          }
        }
      }
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "integer"
        }
      }
    },
    "directRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "db",
        "user",
        "interpreter",
        "entrypoint",
        "power_executable",
        "manifest",
        "machine_contract",
        "read_only_root",
        "tmpfs_bytes",
        "capabilities",
        "no_new_privileges"
      ],
      "properties": {
        "kind": {
          "const": "assistant-direct-v1"
        },
        "db": {
          "const": false
        },
        "user": {
          "const": "10001:10001"
        },
        "interpreter": {
          "const": "/opt/shimpz/runtime/bin/python3.14"
        },
        "entrypoint": {
          "type": "array",
          "prefixItems": [
            {
              "const": "/opt/shimpz/runtime/bin/python3.14"
            },
            {
              "const": "-c"
            },
            {
              "const": "import signal; signal.pause()"
            }
          ],
          "items": false
        },
        "power_executable": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/usr/local/bin/shimpz-power"
                },
                "mode": {
                  "const": 365
                }
              }
            }
          ]
        },
        "manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/opt/shimpz/shimpz.toml"
                },
                "mode": {
                  "const": 292
                }
              }
            }
          ]
        },
        "machine_contract": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/opt/shimpz/shimpz.contract.json"
                },
                "mode": {
                  "const": 292
                }
              }
            }
          ]
        },
        "read_only_root": {
          "const": true
        },
        "tmpfs_bytes": {
          "const": 67108864
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0
        },
        "no_new_privileges": {
          "const": true
        }
      }
    },
    "accountIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "scopes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "provider": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9.:/_-]*$"
          }
        }
      }
    },
    "artifactTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_reference",
        "provenance_reference",
        "signer_identity"
      ],
      "properties": {
        "signature_reference": {
          "$ref": "#/$defs/trustReference"
        },
        "provenance_reference": {
          "$ref": "#/$defs/trustReference"
        },
        "signer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "resolveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "assistant_id",
        "name",
        "assistant_version",
        "creators",
        "source_digest",
        "image_reference",
        "oci_digest",
        "platforms",
        "runtime",
        "manifest_digest",
        "machine_contract_digest",
        "machine_contract",
        "allowed_hosts",
        "accounts",
        "review_state",
        "blocked",
        "sbom_digest",
        "scan_digest",
        "trust"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "assistant_id": {
          "$ref": "#/$defs/assistantIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "assistant_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          }
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "image_reference": {
          "$ref": "#/$defs/imageReference"
        },
        "oci_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "const": "linux/amd64"
            },
            {
              "const": "linux/arm64"
            }
          ],
          "items": false
        },
        "runtime": {
          "$ref": "#/$defs/directRuntime"
        },
        "manifest_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "machine_contract_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "machine_contract": {
          "$ref": "#/$defs/machineContract"
        },
        "allowed_hosts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "accounts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/accountIntent"
          }
        },
        "review_state": {
          "enum": [
            "pending",
            "approved",
            "catalog_rejected"
          ]
        },
        "blocked": {
          "const": false
        },
        "sbom_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "scan_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "trust": {
          "$ref": "#/$defs/artifactTrust"
        }
      }
    },
    "controllerInstallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "team_id",
        "source_digest",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "controllerInstallResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "team_id",
        "assistant_id",
        "source_digest",
        "oci_digest",
        "binding_digest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "const": "installed"
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "assistant_id": {
          "$ref": "#/$defs/assistantIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "oci_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "binding_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "installAuthorizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "account_id",
        "team_id",
        "source_digest",
        "oci_digest",
        "delegation_jti",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "account_id": {
          "$ref": "#/$defs/accountIdentifier"
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "oci_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "delegation_jti": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "installAuthorizationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "authorization_id",
        "account_id",
        "team_id",
        "source_digest",
        "oci_digest",
        "delegation_jti",
        "request_id",
        "idempotency_key",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "authorization_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "account_id": {
          "$ref": "#/$defs/accountIdentifier"
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "oci_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "delegation_jti": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "issued_at": {
          "$ref": "#/$defs/unixTime"
        },
        "expires_at": {
          "$ref": "#/$defs/unixTime"
        }
      }
    }
  }
}
