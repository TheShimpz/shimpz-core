#!/usr/local/bin/python3
"""Deterministic pre-built Power executable for controller integration tests."""

from __future__ import annotations

import json
import re
import sys

MAX_BODY = 512 * 1024
POWERS = {"list-zones", "list-dns-records"}
ZONE_ID = re.compile(r"[0-9a-f]{32}\Z")


def _invocation(power: str) -> dict[str, object]:
    raw = sys.stdin.buffer.read(MAX_BODY + 1)
    if not 0 < len(raw) <= MAX_BODY:
        raise ValueError
    payload = json.loads(raw)
    if not isinstance(payload, dict) or set(payload) != {"input", "accounts"}:
        raise ValueError
    accounts = payload["accounts"]
    if not isinstance(accounts, dict) or set(accounts) != {"cloudflare"}:
        raise ValueError
    token = accounts["cloudflare"]
    if not isinstance(token, str) or not 16 <= len(token) <= 16 * 1024:
        raise ValueError
    power_input = payload["input"]
    expected = {"page", "per_page"} | ({"zone_id"} if power == "list-dns-records" else set())
    if not isinstance(power_input, dict) or set(power_input) != expected:
        raise ValueError
    page = power_input["page"]
    per_page = power_input["per_page"]
    if type(page) is not int or type(per_page) is not int or page < 1 or not 1 <= per_page <= 100:
        raise ValueError
    if power == "list-dns-records" and (
        not isinstance(power_input["zone_id"], str) or ZONE_ID.fullmatch(power_input["zone_id"]) is None
    ):
        raise ValueError
    return power_input


def _result(power: str, power_input: dict[str, object]) -> dict[str, object]:
    pagination = {
        "page": power_input["page"],
        "per_page": power_input["per_page"],
        "count": 0,
        "total_count": 0,
        "total_pages": 0,
    }
    return (
        {"records": [], "pagination": pagination}
        if power == "list-dns-records"
        else {
            "zones": [],
            "pagination": pagination,
        }
    )


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in POWERS:
        return 2
    try:
        result = _result(sys.argv[1], _invocation(sys.argv[1]))
    except OSError, UnicodeError, TypeError, ValueError, json.JSONDecodeError:
        return 3
    sys.stdout.write(json.dumps(result, allow_nan=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
